+                    rp.anchor_len = (size_t) slot.task->params.redraft.anchor_len;
+                    rp.max_tokens = (size_t) slot.task->params.redraft.max_tokens;
+                    rp.eos        = std::unordered_set<redraft::token_id>(slot.task->params.redraft.eos.begin(), slot.task->params.redraft.eos.end());
+                    rp.recurrent  = llama_model_is_recurrent(llama_get_model(ctx_tgt)) || llama_model_is_hybrid(llama_get_model(ctx_tgt));
+                    {
+                        auto tt = slot.prompt.tokens.get_text_tokens();
+                        rp.template_ids = std::vector<redraft::token_id>(tt.begin(), tt.end());
