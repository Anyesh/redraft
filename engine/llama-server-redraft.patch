             }
         }
 
+        // redraft servicing: advance each in-flight stabilize session by one draft
+        // window per tick. Emitted tokens go through the normal token path so SSE
+        // streaming, stop strings, and the n_predict budget reuse the standard
+        // machinery; the session owns its own decode, so this runs even on ticks
+        // where the shared batch is empty (a lone redraft slot) and yields between
+        // windows under --parallel N.
+        for (auto & slot : slots) {
+            if (slot.state != SLOT_STATE_GENERATING || !slot.redraft_session) {
+                continue;
+            }
+
+            std::vector<llama_token> delta = slot.redraft_session->step();
+
+            bool stopped = false;
+            for (llama_token tok : delta) {
+                if (slot.n_decoded == 0) {
+                    slot.t_start_generation = ggml_time_us();
+                    slot.t_prompt_processing = (slot.t_start_generation - slot.t_start_process_prompt) / 1e3;
+                    metrics.on_prompt_eval(slot);
+                }
+                slot.n_decoded += 1;
+                slot.t_token_generation = std::max<int64_t>(1, ggml_time_us() - slot.t_start_generation) / 1e3;
+
+                completion_token_output result;
+                result.tok          = tok;
+                result.text_to_send = common_token_to_piece(slot.ctx_tgt, result.tok, accept_special_token(slot, result.tok));
+                result.prob         = 1.0f;
+
+                if (!process_token(result, slot)) {
+                    stopped = true;
+                    break;
+                }
+            }
+
+            if (stopped || slot.redraft_session->done()) {
+                slot.redraft_held_fraction = slot.redraft_session->held_fraction();
+                slot.redraft_divergences   = slot.redraft_session->divergences();
+                slot.redraft_emitted.assign(slot.redraft_session->emitted().begin(),
+                                            slot.redraft_session->emitted().end());
+                slot.redraft_session.reset();
+
+                slot.print_timings();
+                send_final_response(slot);
+                metrics.on_prediction(slot);
+                slot.release();
+            }
+        }
+
         SRV_DBG("%s", "run slots completed\n");
     }
 
