+                    redraft::redraft_run_params rp;
+                    rp.old_output = std::vector<redraft::token_id>(slot.task->params.redraft.old_output.begin(), slot.task->params.redraft.old_output.end());
+                    rp.tau        = slot.task->params.redraft.tau;
+                    rp.floor      = slot.task->params.redraft.floor;
